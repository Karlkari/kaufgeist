OPENAI_API_KEY=
# Existing model defaults are intentionally unchanged.
OPENAI_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
# Run database/rate-limits.sql before deploying. Service role stays server-side.
SUPABASE_URL=
SUPABASE_KEY=
RATE_LIMIT_SALT=
DAILY_CONSULTATION_LIMIT=100
PER_IP_WINDOW_LIMIT=10
# Public build config, NOT API credentials. Complete account setup first.
PUBLIC_GA4_ID=
PUBLIC_GA4_ENHANCED_MEASUREMENT_DISABLED=
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
